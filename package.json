{
  "name": "comfyui-fl-audiobook-tools-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "clean:chunks": "node scripts/clean-chunks.mjs",
    "compile:vanilla-sass": "node scripts/compile-vanilla-sass.mjs",
    "dev": "npm run clean:chunks && npm run compile:vanilla-sass && vite build --watch --mode development",
    "dev:ui": "vite",
    "build": "npm run clean:chunks && npm run compile:vanilla-sass && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "nvm list": "nvm list",
    "nvm use 22.12.0": "nvm use 22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "happy-dom": "^14.12.0",
    "sass": "^1.104.0",
    "vite": "^5.2.8",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "primeicons": "^7.0.0",
    "primevue": "^3.50.0",
    "vue": "^3.4.21"
  }
}
