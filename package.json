{
  "name": "comfyui-fl-audiobook-tools-frontend",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "clean:chunks": "node scripts/clean-chunks.mjs",
    "dev": "npm run clean:chunks && vite build --watch --mode development",
    "dev:ui": "vite",
    "dev:electron-ui": "vite --config vite.electron.config.js",
    "electron:dev": "electron .",
    "build": "npm run clean:chunks && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "nvm list": "nvm list",
    "nvm use 22.12.0": "nvm use 22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^14.12.0",
    "sass": "^1.104.0",
    "vite": "^5.2.8",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^3.50.0",
    "vue": "^3.4.21"
  }
}
